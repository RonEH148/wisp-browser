<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@style/Theme.TVBro" />

    <!-- Wisp: full-screen settings (only used by the phone build) -->
    <style name="WispSettingsScreen" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/wisp_bg</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorAccent">@color/wisp_accent</item>
        <item name="colorControlActivated">@color/wisp_accent</item>
        <item name="android:alertDialogTheme">@style/WispDialog</item>
        <item name="alertDialogTheme">@style/WispDialog</item>
    </style>

    <!-- Wisp: dialogs as rounded cards with accent-coloured buttons -->
    <style name="WispDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/wisp_dialog_bg</item>
        <item name="colorAccent">@color/wisp_accent</item>
        <item name="colorControlActivated">@color/wisp_accent</item>
        <item name="android:colorAccent">@color/wisp_accent</item>
        <item name="android:textColorPrimary">@color/wisp_text</item>
        <item name="android:textColorSecondary">@color/wisp_text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/wisp_text</item>
        <item name="android:buttonBarButtonStyle">@style/WispDialogButton</item>
        <item name="buttonBarButtonStyle">@style/WispDialogButton</item>
        <item name="android:backgroundDimAmount">0.32</item>
    </style>

    <style name="WispDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/wisp_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
