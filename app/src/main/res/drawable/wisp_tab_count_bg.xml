<?xml version="1.0" encoding="utf-8"?>
<!-- Wisp: the tab counter square on the bottom bar -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33888888">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <inset android:insetLeft="10dp" android:insetRight="10dp" android:insetTop="10dp" android:insetBottom="10dp">
            <shape android:shape="rectangle">
                <stroke android:width="2dp" android:color="@color/wisp_icon" />
                <corners android:radius="6dp" />
            </shape>
        </inset>
    </item>
</ripple>
