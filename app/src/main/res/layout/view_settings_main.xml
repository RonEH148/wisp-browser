<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="22dp"
    android:paddingTop="5dp"
    android:paddingRight="22dp"
    >

    <LinearLayout
        android:id="@+id/llWebEngine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/web_browser_engine_temporary_setting"
            android:textSize="16sp"
            />

        <Spinner
            android:id="@+id/spWebEngine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:dropDownWidth="300dp"
            />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_default_search_engine"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        />

    <Spinner
        android:id="@+id/spEngine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:dropDownWidth="300dp"
        />

    <LinearLayout
        android:id="@+id/llURL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        >

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          android:text="@string/url"
          android:textSize="16sp"
          />

      <EditText
          android:id="@+id/etUrl"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ems="10"
          android:hint="@string/search_engine_url_with_query_placeholder_query"
          android:importantForAutofill="no"
          android:inputType="textUri"
          />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_page"
        android:layout_marginTop="20dp"
        android:textSize="16sp"
        />

    <Spinner
        android:id="@+id/spHomePage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:dropDownWidth="300dp"
        />

    <LinearLayout
        android:id="@+id/llCustomHomePage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/custom_home_page_url"
            android:textSize="16sp"
            />

        <EditText
            android:id="@+id/etCustomHomePageUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="@string/url"
            android:importantForAutofill="no"
            android:inputType="textUri"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llHomePageLinksMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/home_page_links"
            android:textSize="16sp"
            />

        <Spinner
            android:id="@+id/spHomePageLinks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:dropDownWidth="300dp"
            />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_user_agent_string"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        />

    <Spinner
        android:id="@+id/spTitles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:dropDownWidth="300dp"
        />

    <LinearLayout
        android:id="@+id/llUAString"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        >

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          android:text="@string/user_agent_string"
          android:textSize="16sp"
          />

      <EditText
          android:id="@+id/etUAString"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ems="10"
          android:hint="@string/edit_user_agent_string"
          android:importantForAutofill="no"
          android:inputType="textUri"
          />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llAdblock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="horizontal"
        android:paddingTop="5dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lines="1"
            android:text="@string/toggle_ads_blocking"
            android:textSize="16sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/scAdblock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:duplicateParentState="true" />
    </LinearLayout>

  <LinearLayout
      android:id="@+id/llAdBlockerDetails"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:orientation="vertical"
      android:paddingTop="5dp"
      >
    <EditText
        android:id="@+id/etAdBlockerListUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="@string/url"
        android:importantForAutofill="no"
        android:inputType="textUri|textMultiLine"
        android:maxLines="5"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.7"
        android:text="@string/sofa_adblock_lists_hint"
        android:textSize="13sp"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
      <TextView
          android:id="@+id/tvAdBlockerListInfo"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginStart="5dp"
          android:layout_weight="1"
          android:gravity="center_vertical"
          android:lines="1"
          tools:text="Last update: never"
          />
      <ImageButton
          android:id="@+id/btnAdBlockerUpdate"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_weight="0"
          android:contentDescription="@string/update_ad_blocker_list"
          android:nextFocusDown="@+id/scSofaCosmeticFilter"
          android:src="@drawable/ic_refresh_grey_900_24dp"
          />
      <ProgressBar
          android:id="@+id/pbAdBlockerListLoading"
          style="?android:attr/progressBarStyle"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_weight="0"
          android:visibility="gone"
          />
    </LinearLayout>
  </LinearLayout>


  <!-- Lumen extras -->
  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:text="@string/sofa_extras_title"
      android:textSize="18sp"
      android:textStyle="bold"
      />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      >
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/lumen_auto_hide_toolbar"
          android:textSize="16sp"
          />
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="0.7"
          android:text="@string/lumen_auto_hide_toolbar_desc"
          android:textSize="13sp"
          />
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scLumenAutoHideToolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        />
  </LinearLayout>

  <LinearLayout
      android:visibility="gone"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      >
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/lumen_auto_lines"
          android:textSize="16sp"
          />
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="0.7"
          android:text="@string/lumen_auto_lines_desc"
          android:textSize="13sp"
          />
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scLumenAutoLines"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        />
  </LinearLayout>

  <Button
      android:id="@+id/btnLumenBigVideo"
      android:focusable="true"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:text="@string/lumen_big_video_setting"
      />

  <Button
      android:id="@+id/btnLumenHandoffLog"
      android:focusable="true"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:text="@string/lumen_handoff_log"
      />

  <Button
      android:id="@+id/btnLumenCopyPasteAllApps"
      android:focusable="true"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:text="@string/lumen_copy_paste_all_apps"
      />

  <Button
      android:id="@+id/btnLumenDebandSites"
      android:visibility="gone"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:background="@drawable/button_bg_selector"
      android:text="@string/lumen_deband_sites"
      />

  <LinearLayout
      android:id="@+id/llSofaCosmeticFilter"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      >
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/sofa_cosmetic_filter"
          android:textSize="16sp"
          />
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="0.7"
          android:text="@string/sofa_cosmetic_filter_desc"
          android:textSize="13sp"
          />
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scSofaCosmeticFilter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        />
  </LinearLayout>

  <LinearLayout
      android:id="@+id/llSofaPopupBlocker"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      >
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/sofa_popup_blocker"
          android:textSize="16sp"
          />
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="0.7"
          android:text="@string/sofa_popup_blocker_desc"
          android:textSize="13sp"
          />
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scSofaPopupBlocker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        />
  </LinearLayout>

  <LinearLayout
      android:id="@+id/llSofaAutoMaxQuality"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      >
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/sofa_auto_max_quality"
          android:textSize="16sp"
          />
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="0.7"
          android:text="@string/sofa_auto_max_quality_desc"
          android:textSize="13sp"
          />
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scSofaAutoMaxQuality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      >
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/lumen_stop_mini_player"
          android:textSize="16sp"
          />
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="0.7"
          android:text="@string/lumen_stop_mini_player_desc"
          android:textSize="13sp"
          />
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scLumenStopMiniPlayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      >
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/lumen_mouse_clicks"
          android:textSize="16sp"
          />
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="0.7"
          android:text="@string/lumen_mouse_clicks_desc"
          android:textSize="13sp"
          />
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scLumenMouseClicks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        />
  </LinearLayout>

  <LinearLayout
      android:id="@+id/llSofaForceDark"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      >
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/sofa_force_dark"
          android:textSize="16sp"
          />
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="0.7"
          android:text="@string/sofa_force_dark_desc"
          android:textSize="13sp"
          />
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scSofaForceDark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        />
  </LinearLayout>

  <LinearLayout
      android:id="@+id/llSofaCloudflareCompat"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      >
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/sofa_cloudflare_compat"
          android:textSize="16sp"
          />
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="0.7"
          android:text="@string/sofa_cloudflare_compat_desc"
          android:textSize="13sp"
          />
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scSofaCloudflareCompat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        />
  </LinearLayout>

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:text="@string/sofa_user_script"
      android:textSize="16sp"
      />
  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:alpha="0.7"
      android:text="@string/sofa_user_script_desc"
      android:textSize="13sp"
      />
  <EditText
      android:id="@+id/etSofaUserScript"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="top|start"
      android:hint="@string/sofa_user_script_hint"
      android:importantForAutofill="no"
      android:inputType="textMultiLine|textNoSuggestions"
      android:maxLines="6"
      android:minLines="2"
      android:textSize="13sp"
      android:typeface="monospace"
      />
  <Button
      android:id="@+id/btnSofaSaveUserScript"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/sofa_save_user_script"
      />


  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:text="@string/sofa_player_title"
      android:textSize="18sp"
      android:textStyle="bold"
      />
  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:alpha="0.7"
      android:text="@string/lumen_player_about"
      android:textSize="13sp"
      />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      >
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/sofa_match_frame_rate"
          android:textSize="16sp"
          />
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="0.7"
          android:text="@string/sofa_match_frame_rate_desc"
          android:textSize="13sp"
          />
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scSofaMatchFrameRate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      >
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/sofa_tunneling"
          android:textSize="16sp"
          />
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="0.7"
          android:text="@string/sofa_tunneling_desc"
          android:textSize="13sp"
          />
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scSofaPlayerTunneling"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      >
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/lumen_subtitle_box"
          android:textSize="16sp"
          />
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="0.7"
          android:text="@string/lumen_subtitle_box_desc"
          android:textSize="13sp"
          />
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scLumenSubtitleBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        />
  </LinearLayout>

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:text="@string/sofa_passwords_title"
      android:textSize="18sp"
      android:textStyle="bold"
      />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      >
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/sofa_save_passwords"
          android:textSize="16sp"
          />
      <TextView
          android:layout_width="match_parent"
