<?xml version="1.0" encoding="utf-8"?>
<com.phlox.tvwebbrowser.widgets.CheckableContainer xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/web_tab_width"
    android:layout_height="match_parent"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:nextFocusUp="@+id/ibMenu"
    android:nextFocusDown="@+id/flWebViewContainer"
    android:paddingStart="@dimen/web_tab_padding"
    android:paddingEnd="@dimen/web_tab_padding"
    android:background="@drawable/webtab_horizontal_bkg_selector">
    <ImageView
        android:id="@+id/ivFavicon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        tools:src="@drawable/ic_launcher"
        android:scaleType="fitCenter"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp" />
    <!-- Lumen: close button on each tab -->
    <ImageButton
        android:id="@+id/ibCloseTabItem"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="2dp"
        android:background="@drawable/button_bg_selector"
        android:contentDescription="@string/close_tab"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close_grey_900_24dp" />
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/ivFavicon"
        android:layout_toStartOf="@+id/ibCloseTabItem"
        android:duplicateParentState="true"
        android:textColor="@color/webtab_horizontal_text_selector"
        tools:text="@string/app_name"
        android:textSize="16sp"
        android:gravity="center_vertical"
        android:layout_marginStart="3dp"
        android:lines="1"
        android:ellipsize="end"
        android:paddingStart="0dp"
        android:paddingEnd="10dp"/>
</com.phlox.tvwebbrowser.widgets.CheckableContainer>