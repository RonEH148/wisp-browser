<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_downloads"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/day_night_background_color"
    tools:context="com.phlox.tvwebbrowser.activity.downloads.DownloadsActivity">

    <!-- Lumen: start a download from a pasted link -->
    <Button
        android:id="@+id/btnLumenAddDownload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="10dp"
        android:text="@string/lumen_download_from_link" />

    <Button
        android:id="@+id/btnLumenPauseAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@+id/btnLumenAddDownload"
        android:layout_marginTop="10dp"
        android:text="@string/lumen_pause_all" />

    <Button
        android:id="@+id/btnLumenResumeAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@+id/btnLumenPauseAll"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:text="@string/lumen_resume_all" />

    <de.halfbit.pinnedsection.PinnedSectionListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/btnLumenAddDownload"
        android:divider="@color/day_night_list_divider_color"
        android:dividerHeight="1dp"
        android:listSelector="@drawable/list_item_bg_selector"/>

    <TextView
        android:text="@string/nothing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/tvPlaceholder"
        android:layout_below="@+id/btnLumenAddDownload"
        android:gravity="center"
        android:textColor="@color/day_night_text_color"
        android:textSize="30sp"/>
</RelativeLayout>
