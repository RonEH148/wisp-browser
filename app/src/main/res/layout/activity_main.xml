<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rlRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.main.MainActivity"
    android:fitsSystemWindows="true"
    tools:deviceIds="tv"
    android:clipChildren="false">

    <!-- Lumen: the page sits under the top bar; its top margin (= bar height) is set in code, so the
         bar can slide away smoothly without the page being re-laid out during the animation -->
    <com.phlox.tvwebbrowser.widgets.cursor.CursorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:id="@+id/flWebViewContainer" />

    <ProgressBar
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_alignTop="@+id/flWebViewContainer"
        android:id="@+id/progressBar"
        android:progressTint="@color/progressbar_tint"
        android:visibility="visible" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/rlActionBar"
        android:background="@color/top_bar_background"
        android:elevation="5dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.phlox.tvwebbrowser.activity.main.view.ActionBar
            android:id="@+id/vActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.phlox.tvwebbrowser.activity.main.view.tabs.TabsView
            android:id="@+id/vTabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_below="@+id/vActionBar"
            android:layout_toStartOf="@+id/llBottomPanel"
            android:layout_alignParentStart="true"
            android:focusable="true"
            android:nextFocusUp="@+id/ibMenu"
            android:nextFocusDown="@+id/flWebViewContainer"
            />

        <!-- Lumen: navigation buttons live in the always-visible top bar, next to the tabs -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/llBottomPanel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_below="@+id/vActionBar"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="6dp"
            android:clipChildren="false"
            android:gravity="center">

            <ImageButton
      android:layout_marginStart="2dp"
      android:layout_marginEnd="2dp"
      android:padding="10dp"
      android:scaleType="fitCenter"
                android:id="@+id/ibCloseTab"
                android:visibility="gone"
      android:layout_width="44dp"
      android:layout_height="44dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/close_tab"
                android:src="@drawable/ic_close_grey_900_24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ibBack"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageButton
      android:layout_marginStart="2dp"
      android:layout_marginEnd="2dp"
      android:padding="10dp"
      android:scaleType="fitCenter"
                android:id="@+id/ibBack"
      android:layout_width="44dp"
      android:layout_height="44dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/navigate_back"
                android:src="@drawable/back_icon_selector"
                app:layout_constraintEnd_toStartOf="@+id/ibForward"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/ibCloseTab"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <ImageButton
      android:layout_marginStart="2dp"
      android:layout_marginEnd="2dp"
      android:padding="10dp"
      android:scaleType="fitCenter"
                android:id="@+id/ibForward"
      android:layout_width="44dp"
      android:layout_height="44dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/navigate_forward"
                android:src="@drawable/forward_icon_selector"
                app:layout_constraintEnd_toStartOf="@+id/ibRefresh"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/ibBack"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <ImageButton
      android:layout_marginStart="2dp"
      android:layout_marginEnd="2dp"
      android:padding="10dp"
      android:scaleType="fitCenter"
                android:id="@+id/ibRefresh"
      android:layout_width="44dp"
      android:layout_height="44dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/refresh_page"
                android:src="@drawable/ic_refresh_grey_900_24dp"
                app:layout_constraintEnd_toStartOf="@+id/ibAdBlock"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/ibForward"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <ImageButton
      android:layout_marginStart="2dp"
      android:layout_marginEnd="2dp"
      android:padding="10dp"
      android:scaleType="fitCenter"
                android:id="@+id/ibAdBlock"
      android:layout_width="44dp"
      android:layout_height="44dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/toggle_ads_blocking"
                android:src="@drawable/ic_adblock_on"
                app:layout_constraintEnd_toStartOf="@+id/ibPopupBlock"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/ibRefresh"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <ImageButton
      android:layout_marginStart="2dp"
      android:layout_marginEnd="2dp"
      android:padding="10dp"
      android:scaleType="fitCenter"
                android:id="@+id/ibPopupBlock"
      android:layout_width="44dp"
      android:layout_height="44dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/block_popups"
                android:src="@drawable/ic_block_popups"
                app:layout_constraintEnd_toStartOf="@+id/ibDesktopSite"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/ibAdBlock"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- Lumen: desktop site toggle for the current site -->
            <ImageButton
      android:layout_marginStart="2dp"
      android:layout_marginEnd="2dp"
      android:padding="10dp"
      android:scaleType="fitCenter"
                android:id="@+id/ibDesktopSite"
      android:layout_width="44dp"
      android:layout_height="44dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/sofa_desktop_site"
                android:src="@drawable/ic_desktop_site"
                app:layout_constraintEnd_toStartOf="@+id/ibGrabLinks"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/ibPopupBlock"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- Lumen: grab video / audio / subtitle links of the current page -->
            <ImageButton
      android:layout_marginStart="2dp"
      android:layout_marginEnd="2dp"
      android:padding="10dp"
      android:scaleType="fitCenter"
                android:id="@+id/ibGrabLinks"
      android:layout_width="44dp"
      android:layout_height="44dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/lumen_grab"
                android:src="@drawable/ic_grab_links"
                app:layout_constraintEnd_toStartOf="@+id/ibDeband"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/ibDesktopSite"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- Lumen: how many media links the grab button has found on this page -->
            <TextView
                android:id="@+id/tvGrabCount"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:minWidth="18dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:gravity="center"
                android:background="@drawable/lumen_badge_bg"
                android:textColor="#062B2F"
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:elevation="12dp"
                android:focusable="false"
                android:clickable="false"
                android:importantForAccessibility="no"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="@+id/ibGrabLinks"
                app:layout_constraintEnd_toEndOf="@+id/ibGrabLinks"
                tools:text="12"
                tools:visibility="visible"/>

            <!-- Lumen: anime deband for the video on this page -->
            <ImageButton
      android:layout_marginStart="2dp"
      android:layout_marginEnd="2dp"
      android:padding="10dp"
      android:scaleType="fitCenter"
                android:id="@+id/ibDeband"
                android:visibility="gone"
      android:layout_width="44dp"
      android:layout_height="44dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/lumen_deband_page"
                android:src="@drawable/ic_deband"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/ibGrabLinks"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>



            <TextView
                android:id="@+id/tvBlockedAdCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="20dp"
                android:textSize="12sp"
                app:layout_constraintTop_toTopOf="@+id/ibAdBlock"
                app:layout_constraintBottom_toTopOf="@+id/ibAdBlock"
                app:layout_constraintStart_toEndOf="@+id/ibAdBlock"
                app:layout_constraintEnd_toEndOf="@+id/ibAdBlock"
                android:background="@drawable/gray_badge_bg"
                android:gravity="center"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="1" />

            <TextView
                android:id="@+id/tvBlockedPopupCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="20dp"
                android:textSize="12sp"
                app:layout_constraintTop_toTopOf="@+id/ibPopupBlock"
                app:layout_constraintBottom_toTopOf="@+id/ibPopupBlock"
                app:layout_constraintStart_toEndOf="@+id/ibPopupBlock"
                app:layout_constraintEnd_toEndOf="@+id/ibPopupBlock"
                android:background="@drawable/gray_badge_bg"
                android:gravity="center"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="1" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>

    <ImageView
        android:id="@+id/ivMiniatures"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rlActionBar"
        android:scaleType="fitXY"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/llMiniaturePlaceholder"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        android:layout_below="@+id/rlActionBar"
        android:layout_alignWithParentIfMissing="true"
        android:visibility="gone">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_baseline_add_box_24"
            android:layout_marginEnd="20dp"
            tools:ignore="ContentDescription" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:text="@string/open_a_new_tab_here" />
    </LinearLayout>

    
    <com.phlox.tvwebbrowser.activity.main.view.CursorMenuView
        android:id="@+id/vCursorMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        />

    <!-- Lumen: the remote's pointer over the top bar -->
    <com.phlox.tvwebbrowser.activity.main.view.ToolbarCursorView
        android:id="@+id/vToolbarCursor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp" />

    <ProgressBar
        android:id="@+id/progressBarGeneric"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        />

</RelativeLayout>
