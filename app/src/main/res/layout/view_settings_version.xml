<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name_short"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvTitle"
        android:text="@string/web_browser_optimized_for_tvs" />

    <TextView
        android:id="@+id/tvLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvDescription"
        tools:text="https://test.com"
        android:lines="1"
        android:background="@drawable/text_link_background_selector"
        android:focusable="true"
        android:clickable="true"/>

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvLink"
        android:layout_marginTop="20dp"
        android:text="@string/version_s" />

    <TextView
        android:id="@+id/tvBuildFlavor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvVersion"
        tools:text="Build flavor: generic · geckoIncluded" />

    <TextView
        android:id="@+id/tvWebViewVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvBuildFlavor"
        tools:text="WebView Version: 10.0.1" />

    <TextView
        android:id="@+id/tvSupportAuthor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvWebViewVersion"
        android:layout_marginTop="10dp"
        android:lines="1"
        android:background="@drawable/text_link_background_selector"
        android:focusable="true"
        android:clickable="true"
        tools:text="Support the author" />

    <TextView
        android:id="@+id/tvLicense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvSupportAuthor"
        android:lines="1"
        android:background="@drawable/text_link_background_selector"
        android:focusable="true"
        android:clickable="true"
        tools:text="License" />

    <TextView
        android:id="@+id/tvPrivacy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvLicense"
        android:lines="1"
        android:background="@drawable/text_link_background_selector"
        android:focusable="true"
        android:clickable="true"
        tools:text="Privacy policy" />

    <TextView
        android:id="@+id/tvUkraine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/tvPrivacy"
        android:text="@string/why_icon_changed"
        android:lines="1"
        android:ellipsize="end"
        android:background="@drawable/text_link_background_selector"
        android:focusable="true"
        android:clickable="true"/>

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/banner"
        android:layout_alignTop="@+id/tvUkraine"
        android:layout_toEndOf="@+id/tvUkraine" />

    <CheckBox
        android:id="@+id/chkAutoCheckUpdates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvUkraine"
        android:layout_marginTop="30dp"
        android:text="@string/lumen_auto_check_updates"/>

    <LinearLayout
        android:id="@+id/llLumenUpdates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/chkAutoCheckUpdates"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/lumen_check_updates_now"
            android:background="@drawable/button_bg_selector"/>
        <Button
            android:id="@+id/btnUpdateSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/lumen_update_source"
            android:background="@drawable/button_bg_selector"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvUpdateSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/llLumenUpdates"
        android:layout_marginTop="8dp"
        android:alpha="0.7"
        android:textSize="13sp"
        tools:text="Updates from github.com/RonEH148/Player · access token saved"/>
</RelativeLayout>
